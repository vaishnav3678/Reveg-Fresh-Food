# ----------------------------------------------------------------------
# RevEg Fresh Foods - Apache SPA Routing & PHP Backend Configuration
# Compatible with FileZilla / Apache / cPanel / Hostinger PHP hosting
# Supports root directory (/public_html/) and subdirectories (/public_html/site2/)
# ----------------------------------------------------------------------

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure Authorization header is passed to PHP scripts
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # If the requested file or directory exists, serve it directly (images, css, js, php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route api/<endpoint> to api/<endpoint>.php if it exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # Route api sub-paths (e.g. api/products/123 or api/inquiries/123/status) to api/index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]

  # For SPA routing (e.g. /admin, /festive-specials, etc.), fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Protect data directory from direct browser access
<IfModule mod_authz_core.c>
  <FilesMatch "^data/.*\.json$">
    Require all denied
  </FilesMatch>
</IfModule>

# Prevent directory browsing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Set correct MIME types for modern web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
</IfModule>

# Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Custom Cache-Control Headers
<IfModule mod_headers.c>
  # HTML files: never cache so users always get the latest SPA version
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Assets with hashes: cache for 1 year
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Uploaded images: cache with revalidation
  <FilesMatch "\.(webp|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
